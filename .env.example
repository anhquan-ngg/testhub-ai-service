GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# INTERNAL_API_TOKEN nên là chuỗi bí mật ngẫu nhiên, dài và khó đoán, dùng để NestJS xác thực khi gọi AI service.Khuyến nghị sinh ra từ 32 byte ngẫu nhiên (256 bit)
INTERNAL_API_TOKEN=
GEMINI_TIMEOUT_MS=30000
# Total deadline including queue wait, SDK retries and output validation.
GENERATION_TIMEOUT_MS=30000
# Maximum attempts including the first call (1 disables retries).
GEMINI_MAX_ATTEMPTS=3
MAX_CONCURRENT_GENERATIONS=4
