GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# INTERNAL_API_TOKEN nên là chuỗi bí mật ngẫu nhiên, dài và khó đoán, dùng để NestJS xác thực khi gọi AI service.Khuyến nghị sinh ra từ 32 byte ngẫu nhiên (256 bit)
INTERNAL_API_TOKEN=
GEMINI_TIMEOUT_MS=30000
# Total deadline including queue wait, SDK retries and output validation.
# Deadline chain (must nest): backend AI_SERVICE_TIMEOUT_MS > grounded deadline
# > GENERATION_TIMEOUT_MS > ROUTER_TIMEOUT_MS. Slow 9Router models (e.g. reasoning
# medium/high) can take 80s+, so raise these when LLM_PROVIDER=9router.
GENERATION_TIMEOUT_MS=30000
# Outer deadline for /internal/rag/generate. 0 = max(75000, GENERATION_TIMEOUT_MS + 15000).
GROUNDED_GENERATION_TIMEOUT_MS=0
# Maximum attempts including the first call (1 disables retries).
GEMINI_MAX_ATTEMPTS=3
MAX_CONCURRENT_GENERATIONS=4

# Optional indexing/retrieval. Embeddings use EMBEDDING_GOOGLE_API_KEY, falling back to GEMINI_API_KEY.
RAG_ENABLED=false
# Same PostgreSQL database, dedicated role owns only rag; URL-encode password.
RAG_DATABASE_URL=postgresql://testhub_ai:CHANGE_ME@127.0.0.1:5432/testhub
# Dedicated Google key for embeddings. Create it in a SEPARATE Google Cloud project so embedding
# traffic has its own quota and cannot starve question generation. Empty = reuse GEMINI_API_KEY.
EMBEDDING_GOOGLE_API_KEY=
# Process-wide embedding guard (Gemini limits are per Google Cloud project, not per key).
# Item budget per rolling minute across indexing + retrieval. The limiter is per process, so use
# floor(project RPM * 0.8 / (replicas * uvicorn workers)).
EMBEDDING_MAX_RPM=60
EMBEDDING_MAX_CONCURRENCY=2
# Attempts including the first call; retries only 429/5xx/transport errors, never daily quota.
EMBEDDING_MAX_ATTEMPTS=4
EMBEDDING_MAX_BACKOFF_MS=8000
# Total sleep budget per embed call; must stay well below the 40s RAG operation deadline.
EMBEDDING_RETRY_BUDGET_MS=15000
# In-memory LRU of normalized vectors keyed by model/dims/task/text hash (0 disables).
EMBEDDING_CACHE_SIZE=2048
# Share (1..100 percent) of EMBEDDING_MAX_RPM that indexing may use; retrieval keeps the rest.
# 100 disables the cap. Indexing also yields briefly while a retrieval call is in flight.
EMBEDDING_INDEXING_RPM_PERCENT=50
# In-flight indexing embedding calls per process (retrieval is never limited by this).
EMBEDDING_INDEXING_MAX_CONCURRENCY=1
# Durable pgvector cache for query embeddings; apply migrations/003_embedding_cache.sql first.
# Fails open (falls back to Google) if the table is missing or the database is slow.
EMBEDDING_PERSISTENT_CACHE_ENABLED=false
EMBEDDING_PERSISTENT_CACHE_TTL_DAYS=30
# Local requests-per-day guard (0 = off). Set to floor(project RPD / replicas); free tier RPD is 1000.
# Counts items actually sent to Google (cache hits excluded), resets at midnight Pacific (assumed) and
# on restart. Indexing is rejected at EMBEDDING_DAILY_INDEXING_PERCENT so queries keep headroom;
# at the limit calls fail early with RAG_EMBEDDING_QUOTA_EXHAUSTED (non-retryable).
EMBEDDING_DAILY_LIMIT=0
EMBEDDING_DAILY_WARN_PERCENT=80
EMBEDDING_DAILY_INDEXING_PERCENT=80

# LLM provider for question generation: gemini (default) or 9router.
# Embedding/RAG ignores this setting and uses EMBEDDING_GOOGLE_API_KEY (or GEMINI_API_KEY).
LLM_PROVIDER=gemini
# Used only when LLM_PROVIDER=9router. Base URL must end with /v1.
# Inside Docker, 127.0.0.1 is the container itself, not the host.
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=
ROUTER_TIMEOUT_MS=30000
# Optional: empty (default) or gemini. Used only when the primary provider is unreachable
# or rejects capacity (connection error, 429, 5xx). Never used on timeout or invalid output.
# Requires GEMINI_API_KEY and must differ from LLM_PROVIDER.
LLM_FALLBACK_PROVIDER=
ROUTER_MAX_ATTEMPTS=1
ROUTER_MAX_OUTPUT_TOKENS=16384
# json_schema (strict) or json_object (fallback if the upstream model rejects json_schema).
ROUTER_RESPONSE_FORMAT=json_schema
# Explicit plan-targeted supplemental OCR with a 9router vision model (off by default).
# Ordinary extraction never calls OCR. Daily limits are per process; 0 is unlimited.
# Requires ROUTER_BASE_URL / ROUTER_API_KEY. Apply migrations/004_ocr_page_cache.sql before enabling the persistent cache.
OCR_ENABLED=false
OCR_MODEL=
OCR_MAX_PAGES=30
OCR_MAX_CONCURRENCY=3
OCR_MAX_ATTEMPTS=2
OCR_TIMEOUT_MS=30000
OCR_TIME_BUDGET_MS=35000
OCR_DAILY_PAGE_LIMIT=0
OCR_PERSISTENT_CACHE_ENABLED=false
OCR_CONFIG_VERSION=v1
