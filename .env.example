GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# INTERNAL_API_TOKEN nên là chuỗi bí mật ngẫu nhiên, dài và khó đoán, dùng để NestJS xác thực khi gọi AI service.Khuyến nghị sinh ra từ 32 byte ngẫu nhiên (256 bit)
INTERNAL_API_TOKEN=
GEMINI_TIMEOUT_MS=30000
# Total deadline including queue wait, SDK retries and output validation.
GENERATION_TIMEOUT_MS=30000
# Maximum attempts including the first call (1 disables retries).
GEMINI_MAX_ATTEMPTS=3
MAX_CONCURRENT_GENERATIONS=4

# Optional indexing/retrieval; reuses GEMINI_API_KEY above.
RAG_ENABLED=false
# Same PostgreSQL database, dedicated role owns only rag; URL-encode password.
RAG_DATABASE_URL=postgresql://testhub_ai:CHANGE_ME@127.0.0.1:5432/testhub

# LLM provider for question generation: gemini (default) or 9router.
# Embedding/RAG always uses GEMINI_API_KEY regardless of this setting.
LLM_PROVIDER=gemini
# Used only when LLM_PROVIDER=9router. Base URL must end with /v1.
# Inside Docker, 127.0.0.1 is the container itself, not the host.
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=
ROUTER_TIMEOUT_MS=30000
ROUTER_MAX_ATTEMPTS=1
ROUTER_MAX_OUTPUT_TOKENS=16384
# json_schema (strict) or json_object (fallback if the upstream model rejects json_schema).
ROUTER_RESPONSE_FORMAT=json_schema