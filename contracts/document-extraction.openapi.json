{
  "openapi": "3.1.0",
  "info": {
    "title": "TestHub AI Service",
    "version": "0.1.0"
  },
  "paths": {
    "/internal/documents/extract": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Extract Document",
        "description": "Receive owner-authorized bytes from NestJS and return source-positioned text.",
        "operationId": "extract_document_internal_documents_extract_post",
        "security": [
          {
            "InternalToken": []
          }
        ],
        "parameters": [
          {
            "name": "source_type",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "PDF",
                "PPTX"
              ],
              "type": "string",
              "title": "Source Type"
            }
          },
          {
            "name": "include_notes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Notes"
            }
          },
          {
            "name": "ocr_mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "off",
                "targeted"
              ],
              "type": "string",
              "default": "off",
              "title": "Ocr Mode"
            }
          },
          {
            "name": "ocr_positions",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 180,
              "pattern": "^([1-9][0-9]*(,[1-9][0-9]*)*)?$",
              "default": "",
              "title": "Ocr Positions"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResult"
                }
              }
            }
          },
          "401": {
            "description": "Internal token missing or invalid"
          },
          "413": {
            "description": "Actual input byte limit exceeded"
          },
          "415": {
            "description": "application/octet-stream required"
          },
          "422": {
            "description": "Invalid, encrypted, unsupported or excessive document"
          },
          "503": {
            "description": "Capacity reached or processing infrastructure unavailable"
          },
          "504": {
            "description": "Overall extraction deadline exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExtractionQuality": {
        "properties": {
          "total_units": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Total Units"
          },
          "text_units": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Text Units"
          },
          "ocr_suspected_units": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Ocr Suspected Units"
          },
          "blank_units": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Blank Units"
          },
          "ocr_units": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Ocr Units"
          },
          "ocr_candidate_units": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Ocr Candidate Units"
          },
          "ocr_pages": {
            "items": {
              "$ref": "#/components/schemas/OcrPage"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Ocr Pages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "total_units",
          "text_units",
          "ocr_suspected_units",
          "blank_units"
        ],
        "title": "ExtractionQuality",
        "description": "Per-unit text classification; positions are original page/slide numbers."
      },
      "ExtractionResult": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "document-extraction.v1",
            "title": "Contract Version",
            "default": "document-extraction.v1"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "PDF",
              "PPTX"
            ],
            "title": "Source Type"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Sha256"
          },
          "parser_version": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9./;:_-]+$",
            "title": "Parser Version"
          },
          "include_notes": {
            "type": "boolean",
            "title": "Include Notes"
          },
          "status": {
            "type": "string",
            "enum": [
              "EXTRACTED",
              "PARTIAL",
              "OCR_REQUIRED"
            ],
            "title": "Status"
          },
          "unit_count": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Unit Count"
          },
          "spans": {
            "items": {
              "$ref": "#/components/schemas/SourceSpan"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Spans"
          },
          "warnings": {
            "items": {
              "type": "string",
              "enum": [
                "EMPTY_UNITS",
                "OCR_REQUIRED",
                "PARTIAL_EXTRACTION",
                "NO_USABLE_TEXT"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "title": "Warnings"
          },
          "quality": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExtractionQuality"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_type",
          "source_sha256",
          "parser_version",
          "include_notes",
          "status",
          "unit_count",
          "spans",
          "warnings"
        ],
        "title": "ExtractionResult"
      },
      "OcrPage": {
        "properties": {
          "position": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Position"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED",
              "NO_TEXT",
              "FAILED",
              "BUDGET_EXHAUSTED",
              "DISABLED"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PAGE_LIMIT",
                  "TIME_BUDGET",
                  "DAILY_LIMIT",
                  "PROVIDER_ERROR",
                  "RENDER_FAILED",
                  "NO_ADDITIONAL_TEXT",
                  "OCR_DISABLED",
                  "CACHE_UNAVAILABLE",
                  "TEXT_LIMIT"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "position",
          "status"
        ],
        "title": "OcrPage",
        "description": "Observable OCR outcome; a nonempty text layer does not imply OCR completion."
      },
      "SourceSpan": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "PAGE",
              "SLIDE",
              "NOTES"
            ],
            "title": "Kind"
          },
          "position": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Position"
          },
          "text": {
            "type": "string",
            "maxLength": 1000000,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "position",
          "text"
        ],
        "title": "SourceSpan"
      }
    },
    "securitySchemes": {
      "InternalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-token"
      }
    }
  }
}
